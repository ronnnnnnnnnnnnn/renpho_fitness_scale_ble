{
  "domain": "renpho_fitness_scale_ble",
  "name": "Renpho Fitness Scale BLE",
  "after_dependencies": [
    "bluetooth",
    "esphome"
  ],
  "bluetooth": [
    {
      "connectable": true,
      "local_name": "Renpho-Scale*"
    },
    {
      "connectable": true,
      "local_name": "QN-Scale*"
    },
    {
      "connectable": true,
      "local_name": "FF:03:00:*"
    },
    {
      "connectable": true,
      "local_name": "FF:04:00:*"
    },
    {
      "connectable": false,
      "manufacturer_id": 65535,
      "manufacturer_data_start": [
        170,
        187
      ]
    }
  ],
  "codeowners": [
    "@ronnnnnnnnnnnnn"
  ],
  "config_flow": true,
  "dependencies": [
    "bluetooth_adapters"
  ],
  "documentation": "https://github.com/ronnnnnnnnnnnnn/renpho_fitness_scale_ble",
  "integration_type": "device",
  "iot_class": "local_push",
  "issue_tracker": "https://github.com/ronnnnnnnnnnnnn/renpho_fitness_scale_ble/issues",
  "requirements": [
    "renpho-escs20m==0.5.0",
    "multi-user-scale-core==0.2.0"
  ],
  "version": "0.3.2"
}
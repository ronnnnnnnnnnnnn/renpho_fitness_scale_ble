{
  "domain": "renpho_fitness_scale_ble",
  "name": "Renpho Fitness Scale BLE",
  "after_dependencies": ["bluetooth", "esphome"],
  "bluetooth": [
    {
      "connectable": true,
      "local_name": "Renpho-Scale*"
    }
  ],
  "codeowners": ["@ronnnnnnnnnnnnn"],
  "config_flow": true,
  "dependencies": ["bluetooth_adapters"],
  "documentation": "https://github.com/ronnnnnnnnnnnnn/renpho_fitness_scale_ble",
  "integration_type": "device",
  "iot_class": "local_push",
  "issue_tracker": "https://github.com/ronnnnnnnnnnnnn/renpho_fitness_scale_ble/issues",
  "requirements": ["renpho-escs20m==0.2.0", "multi-user-scale-core==0.1.1"],
  "version": "0.1.1"
}
